   "id": "grafana",
   "name": "Grafana",
   "version": "9.0.0"
  }
 ],
 "uid": "claude-code-amp",
 "title": "Claude Code (AMP)",
 "description": "Claude Code usage metrics from the Amazon Managed Service for Prometheus workspace (GovCloud AMP metrics backend). Counters are cumulative (deltatocumulative in the sidecar collector), so panels aggregate with increase(). See deployment/grafana/README.md for setup.",
 "tags": [
  "claude-code",
  "bedrock",
  "amp"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "timezone": "browser",
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Overview",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Total Tokens Used",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(claude_code_token_usage[$__range]))",
     "instant": true,
     "range": false
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Active Users",
   "datasource": {
    "type": "prometheus",
